# iVIT-SDK Full Build Environment (All backends)
#
# 包含: OpenVINO + TensorRT
# 需要: NVIDIA GPU
#
# 建置映像：
#   docker build -t ivit-full-test -f docker/Dockerfile.full .
#
# 執行驗證（需要 GPU）：
#   docker run -it --rm --gpus all -v $(pwd):/workspace/ivit-sdk ivit-full-test verify-sdk.sh
#
# 執行互動模式：
#   docker run -it --rm --gpus all -v $(pwd):/workspace/ivit-sdk ivit-full-test bash

FROM nvcr.io/nvidia/tensorrt:24.01-py3

LABEL maintainer="Innodisk AI Team <ai@innodisk.com>"
LABEL description="iVIT-SDK full build environment with all backends"

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# 基本工具 + OpenCV + GTest
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    pkg-config \
    git \
    wget \
    curl \
    unzip \
    gpg-agent \
    libopencv-dev \
    libgtest-dev \
    python3-dev \
    python3-pip \
    python3-venv \
    libssl-dev \
    libffi-dev \
    vim \
    htop \
    tree \
    && rm -rf /var/lib/apt/lists/*

# 安裝 OpenVINO 2024
RUN wget -qO- https://apt.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB \
    | gpg --dearmor -o /usr/share/keyrings/intel.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/intel.gpg] https://apt.repos.intel.com/openvino/2024 ubuntu22 main" \
    > /etc/apt/sources.list.d/intel-openvino.list \
    && apt-get update && apt-get install -y openvino-2024.0.0 \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# Python 環境
# ============================================================================
RUN pip3 install --upgrade pip setuptools wheel && \
    pip3 install --no-cache-dir \
    pybind11 \
    numpy \
    opencv-python-headless \
    pillow \
    pyyaml \
    requests \
    tqdm \
    pytest \
    scikit-build-core

# ============================================================================
# 測試資料準備
# ============================================================================
RUN mkdir -p /opt/test-data/images /opt/test-data/models

# 下載測試圖片（COCO sample images）
RUN wget -q -O /opt/test-data/images/bus.jpg \
    "http://images.cocodataset.org/val2017/000000000785.jpg" && \
    wget -q -O /opt/test-data/images/zidane.jpg \
    "http://images.cocodataset.org/val2017/000000000139.jpg"

# 下載預訓練模型（YOLOX-S ONNX）
RUN wget -q -O /opt/test-data/models/yolox-s.onnx \
    "https://github.com/innodisk-mannywang/ivit-sdk/releases/download/models-v1.0/yolox-s.onnx"

# ============================================================================
# 工作目錄設定
# ============================================================================
WORKDIR /workspace

# 複製驗證腳本
COPY docker/verify-sdk.sh /usr/local/bin/verify-sdk.sh
RUN chmod +x /usr/local/bin/verify-sdk.sh

# 複製建置腳本
COPY docker/build-full.sh /usr/local/bin/build-full.sh
RUN chmod +x /usr/local/bin/build-full.sh

# 複製快速啟動腳本
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash"]
